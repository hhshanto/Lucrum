# Copy to .env and fill in. .env is gitignored and must stay that way --
# it holds live Walmart credentials.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development, served by docker-compose.yml:
#   docker compose up -d
#
# Host port is 55432 rather than 5432. Windows reserves dynamic port ranges
# for Hyper-V/WSL and 5432 commonly falls inside one, which fails as a
# permissions error even with nothing listening. Check yours with:
#   netsh int ipv4 show excludedportrange protocol=tcp
DATABASE_URL=postgresql://lucrum:lucrum@localhost:55432/lucrum

# ---------------------------------------------------------------------------
# Walmart Marketplace API
# ---------------------------------------------------------------------------
# Used by the walmart-probe agent to record fixtures and populate the pending
# configuration items C-01 and C-02. Never write these into a recorded fixture.
WALMART_CLIENT_ID=
WALMART_SECRET_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Secret for signing sessions. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# development | production
APP_ENV=development
